# Template dokumentasi. Jangan gunakan kredensial produksi untuk lokal.
# API -> apps/api/.env (baru dipakai Fase 1)
NODE_ENV=development
PORT=4000
WEB_USER_ORIGIN=http://localhost:3000
WEB_ADMIN_ORIGIN=http://localhost:3001
WEB_TENANT_ORIGIN=http://localhost:3002
# Runtime: role kantin_api, bukan postgres/service_role/table owner; NOBYPASSRLS.
DATABASE_URL=postgresql://kantin_api:REPLACE_ME@REPLACE_ME:5432/postgres?sslmode=require
# Migrasi saja; JANGAN tersedia pada proses API Railway.
DIRECT_URL=postgresql://REPLACE_MIGRATION_ROLE:REPLACE_ME@REPLACE_ME:5432/postgres?sslmode=require&schema=app_private
SUPABASE_URL=https://REPLACE_ME.supabase.co
SUPABASE_JWKS_URL=https://REPLACE_ME.supabase.co/auth/v1/.well-known/jwks.json
# API saja, untuk provisioning Auth/Storage melalui Express.
SUPABASE_SECRET_KEY=REPLACE_ME
STORAGE_MENU_BUCKET=menu-photos
STORAGE_QRIS_BUCKET=tenant-qris
STORAGE_MAP_BUCKET=floor-maps
# Usulan tracker tanpa login: kunci import Supabase, perlu spike SEC-01.
TRACKER_SIGNING_PRIVATE_JWK=REPLACE_ME
TRACKER_SIGNING_KEY_ID=REPLACE_ME
TRACKER_TOKEN_TTL_SECONDS=300
# Random 32-byte base64 key; backend encrypts idempotent checkout replay.
IDEMPOTENCY_ENCRYPTION_KEY=REPLACE_ME
LOG_LEVEL=info
# Frontend -> .env.local di web-user, web-admin, dan web-tenant.
# Variabel NEXT_PUBLIC berikut hanya berisi konfigurasi publik, bukan secret.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_ME.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_ME

# Opsional untuk link antar-frontend pada pratinjau lokal.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_USER_URL=http://localhost:3000
NEXT_PUBLIC_TENANT_URL=http://localhost:3002
