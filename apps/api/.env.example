# Runtime Express/Prisma connection: use the kantin_api role configured by the operator.
# Copy a connection template from Supabase Connect; URL-encode the password.
DATABASE_URL=postgresql://kantin_api:REPLACE_ENCODED_PASSWORD@db.REPLACE_PROJECT_REF.supabase.co:5432/postgres?sslmode=require&schema=public
# CLI/migrations only. Do not give this owner credential to the Railway API process.
DIRECT_URL=postgresql://postgres:REPLACE_ENCODED_OWNER_PASSWORD@db.REPLACE_PROJECT_REF.supabase.co:5432/postgres?sslmode=require&schema=app_private
SUPABASE_URL=https://REPLACE_PROJECT_REF.supabase.co
SUPABASE_JWKS_URL=https://REPLACE_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SECRET_KEY=REPLACE_SERVER_ONLY_SECRET_KEY
STORAGE_MENU_BUCKET=menu-photos
STORAGE_QRIS_BUCKET=tenant-qris
STORAGE_MAP_BUCKET=floor-maps
# API encrypts idempotent replay with AES-256-GCM; independent random 32-byte key in base64.
IDEMPOTENCY_ENCRYPTION_KEY=REPLACE_RANDOM_32_BYTE_BASE64_KEY
TRACKER_SIGNING_PRIVATE_JWK=REPLACE_IMPORTED_SUPABASE_PRIVATE_JWK
TRACKER_SIGNING_KEY_ID=REPLACE_SIGNING_KEY_KID
TRACKER_TOKEN_TTL_SECONDS=300
PORT=4000
NODE_ENV=development
WEB_USER_ORIGIN=http://localhost:3000
WEB_ADMIN_ORIGIN=http://localhost:3001
LOG_LEVEL=info
API_RATE_LIMIT_PER_MINUTE=3600

UNPAID_ORDER_TTL_MINUTES=15
