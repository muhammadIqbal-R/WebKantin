{
  "name": "@kantin/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@kantin/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@supabase/supabase-js": "2.119.0",
    "busboy": "1.6.0",
    "express": "5.3.0",
    "jose": "6.2.18",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@types/busboy": "1.5.5",
    "@types/express": "5.0.6",
    "prisma": "7.10.1"
  },
  "scripts": {
    "key:setup":"node scripts/setup-replay-key.mjs",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint src --ignore-pattern src/generated",
    "typecheck": "tsc --noEmit",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "test": "node --test test/database.test.mjs test/management.test.mjs test/owned-orders.test.mjs && tsx --test test/http.test.ts test/onboarding.test.mjs test/replay.test.ts test/checkout-service.test.mjs test/vendor-api.test.mjs"
  }
}
